PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/campus_lost_found
JWT_SECRET=super-secret-campus-jwt
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=

# Optional cloud storage (photos fall back to compressed base64 in Mongo if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Groq AI assistant
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Email (Brevo / SMTP relay) — notifications + password reset
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
SENDER_EMAIL=
SENDER_NAME=Prompt Hunter