PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/campus_lost_found
JWT_SECRET=super-secret-campus-jwt
CLIENT_URL=http://localhost:5173

# Optional cloud storage (photos fall back to compressed base64 in Mongo if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional email worker (log-only when empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Campus Lost & Found <no-reply@campus.edu>"